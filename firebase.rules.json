{
  "rules": {
    ".read": false,
    ".write": false,
    "capsuleEntries": {
      ".read": "now >= 1761955200000",
      "$entryId": {
        ".write": true,
        ".validate": "newData.hasChildren(['name','message','submittedAt'])"
      }
    },
    "sheetSubmissions": {
      "$sheetName": {
        "$entryId": {
          ".read": false,
          ".write": true,
          ".validate": "newData.hasChildren(['sheetName','rowIndex','submittedAt','fields'])"
        }
      }
    }
  }
}
